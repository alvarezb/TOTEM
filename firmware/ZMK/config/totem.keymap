#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// ── Layer indices ──────────────────────────────────────────────
#define BASE        0
#define QWERTY      1
#define COLEMAK_DH  2
#define COLEMAK     3
#define LOWER       4
#define RAISE       5
#define ADJUST      6
#define WIN_MODS    7
#define WIN_LOWER   8
#define WIN_RAISE   9
#define WIN_ADJUST  10

// ── Hold-tap / tap-dance / macro behaviors ────────────────────
/ {
    behaviors {
        // Layer-tap for RAISE/LOWER thumb keys
        // QMK: TAPPING_TERM = 200ms, FLOW_TAP_TERM = 150ms (config.h)
        lth: layer_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // Mod-tap for CMD / SHIFT / CTRL / ALT thumb keys
        mth: mod_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        // SWP_LAYOUT: 1 tap = QWERTY, 2 taps = Colemak-DH, 3 taps = Colemak
        td_layout: td_layout {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&to QWERTY>, <&to COLEMAK_DH>, <&to COLEMAK>;
        };
    };

    macros {
        // OS status — types "macOS" or "Windows" into focused window
        // Matches QMK type_os_and_layout() OS portion
        mac_status: mac_status {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp A &kp C &kp O &kp S>;
        };

        win_status: win_status {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp I &kp N &kp D &kp O &kp W &kp S>;
        };
    };

    // ── WIN_* conditional layers ─────────────────────────────
    // WIN_MODS (7) is a completely empty "flag" layer — it contains only
    // &trans and exists solely to trigger these conditional layers.
    // See plan for why WIN_MODS must be empty (layer priority issue).
    conditional_layers {
        compatible = "zmk,conditional-layers";
        win_lower_activate {
            if-layers = <LOWER WIN_MODS>;
            then-layer = <WIN_LOWER>;
        };
        win_raise_activate {
            if-layers = <RAISE WIN_MODS>;
            then-layer = <WIN_RAISE>;
        };
        win_adjust_activate {
            if-layers = <ADJUST WIN_MODS>;
            then-layer = <WIN_ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

// ════════════════════════════════════════════════════════════════
// 0: BASE — outer-column punctuation + thumb hold-taps
//    All alphas are transparent (fall through to QWERTY/Colemak)
//
//        ·    ·    ·    ·    ·   |   ·    ·    ·    ·    ;
//        ·    ·    ·    ·    ·   |   ·    ·    ·    ·    ·
//    '   ·    ·    ·    ·    ·   |   ·    ·    ,    .    /    -
//              ESC  TAB  SPC     |        SPC  RET  BSP
//             RAISE LOWER CMD    |       SHFT CTRL  ALT
// ════════════════════════════════════════════════════════════════
        base_layer {
            bindings = <
// row 0 (top)
&none     &none     &none     &none     &none       &none     &none     &none     &none     &kp SEMI
// row 1 (home)
&none     &none     &none     &none     &none       &none     &none     &none     &none     &none
// outer-L + row 2 (bottom) + outer-R
&kp SQT   &none     &none     &none     &none     &none       &none     &none     &kp COMMA &kp DOT   &kp FSLH  &kp MINUS
// thumbs: L-outer  L-middle        L-inner         R-inner         R-middle        R-outer
&lth RAISE ESC   &lth LOWER TAB   &mth LGUI SPACE   &mth LSHFT SPACE   &mth LCTRL RET   &mth LALT BSPC
            >;
        };

// ════════════════════════════════════════════════════════════════
// 1: QWERTY
// ════════════════════════════════════════════════════════════════
        qwerty_layer {
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T   &kp Y  &kp U  &kp I  &kp O  &trans
&kp A  &kp S  &kp D  &kp F  &kp G   &kp H  &kp J  &kp K  &kp L  &kp P
&trans &kp Z  &kp X  &kp C  &kp V   &kp B  &kp N  &kp M  &trans &trans &trans &trans
                      &trans &trans  &trans &trans &trans &trans
            >;
        };

// ════════════════════════════════════════════════════════════════
// 2: COLEMAK-DH
// ════════════════════════════════════════════════════════════════
        colemak_dh_layer {
            bindings = <
&kp Q  &kp W  &kp F  &kp P  &kp B   &kp J  &kp L  &kp U  &kp Y  &trans
&kp A  &kp R  &kp S  &kp T  &kp G   &kp M  &kp N  &kp E  &kp I  &kp O
&trans &kp Z  &kp X  &kp C  &kp D   &kp V  &kp K  &kp H  &trans &trans &trans &trans
                      &trans &trans  &trans &trans &trans &trans
            >;
        };

// ════════════════════════════════════════════════════════════════
// 3: COLEMAK
// ════════════════════════════════════════════════════════════════
        colemak_layer {
            bindings = <
&kp Q  &kp W  &kp F  &kp P  &kp G   &kp J  &kp L  &kp U  &kp Y  &trans
&kp A  &kp R  &kp S  &kp T  &kp D   &kp H  &kp N  &kp E  &kp I  &kp O
&trans &kp Z  &kp X  &kp C  &kp V   &kp B  &kp K  &kp M  &trans &trans &trans &trans
                      &trans &trans  &trans &trans &trans &trans
            >;
        };

// ════════════════════════════════════════════════════════════════
// 4: LOWER — numbers, navigation, browser shortcuts (RED)
//
//   CS+TAB close-tab  UP   reopen-tab   {  |  }   7   8   9   =
//   C+TAB  LEFT       DOWN RIGHT        (  |  )   4   5   6   -
//  ·  emoji  ·      K_BACK K_FWD        [  |  ]   1   2   3   *   =
//                  ADJUST  ·    ·          ·   ·  0
//
// K_BACK/K_FORWARD: native HID AC-Back/AC-Forward, works on modern macOS.
// If macOS rejects these, add MAC overrides in WIN_LOWER (swap Mac/Win).
// ════════════════════════════════════════════════════════════════
        lower_layer {
            bindings = <
&kp RC(RS(TAB))  &kp LG(W)           &kp UP    &kp LS(LG(T))  &kp LBRC    &kp RBRC  &kp N7  &kp N8  &kp N9  &kp EQUAL
&kp LC(TAB)      &kp LEFT            &kp DOWN  &kp RIGHT      &kp LPAR    &kp RPAR  &kp N4  &kp N5  &kp N6  &kp MINUS
&trans  &kp LC(LG(SPACE))  &trans    &kp K_BACK  &kp K_FORWARD  &kp LBKT  &kp RBKT  &kp N1  &kp N2  &kp N3  &kp STAR  &kp EQUAL
                            &mo ADJUST  &trans  &trans          &trans    &trans    &kp N0
            >;
        };

// ════════════════════════════════════════════════════════════════
// 5: RAISE — symbols, modifiers, media (BLUE)
//
//        !    @    #    $    %   |   ^    &    *    \    |
//        CTRL ALT  CMD  SHFT  `  |   '    ·    ·    ·    ·
//  status ·   CUT  COPY PASTE  - |  VOLD VOLU PREV PLAY NEXT  ·
//              ·   ADJUST  ·     |   ·  ADJUST DEL
// ════════════════════════════════════════════════════════════════
        raise_layer {
            bindings = <
&kp EXCL   &kp AT    &kp HASH   &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS     &kp STAR   &kp BSLH    &kp PIPE
&kp LCTRL  &kp LALT  &kp LGUI   &kp LSHFT &kp GRAVE    &kp SQT    &trans       &trans     &trans      &trans
&mac_status  &trans  &kp LG(X)  &kp LG(C) &kp LG(V)    &kp MINUS  &kp C_VOL_DN &kp C_VOL_UP &kp C_PREV &kp C_PP  &kp C_NEXT  &trans
                     &trans     &mo ADJUST &trans        &trans     &mo ADJUST   &kp DEL
            >;
        };

// ════════════════════════════════════════════════════════════════
// 6: ADJUST — F-keys, BT, layout, window management
//
//    · SWP_LYT TOP_HALF BT_CLR BT_SEL0  |  ·   F7   F8   F9   F12
//    RESET L_HALF  MAX  R_HALF BT_SEL1  |  ·   F4   F5   F6   F11
// WIN ·  L_1WIN BOT_HALF R_1WIN BT_SEL2 |  ·   F1   F2   F3   F10  ·
//              ·    ·    ·               |   ·   ·   ·
//
// Q (top-left outer pinky) = empty: use double-tap physical reset button to flash
// SWP_LYT: 1-tap=QWERTY, 2-tap=Colemak-DH, 3-tap=Colemak
// WIN toggle (outer-L): same position as QMK SWAP_OS
// BT keys: T/G/B=select 0/1/2 (QWERTY inner-index column), R=clear
// Window mgmt (Mac): E=top, S=left, D=max, F=right, X=l1win, C=bot, V=r1win
// ════════════════════════════════════════════════════════════════
        adjust_layer {
            bindings = <
&trans      &td_layout          &kp LC(LA(UP))     &bt BT_CLR           &bt BT_SEL 0    &none  &kp F7  &kp F8  &kp F9  &kp F12
&sys_reset  &kp LC(LA(LEFT))    &kp LC(LA(RET))    &kp LC(LA(RIGHT))    &bt BT_SEL 1    &none  &kp F4  &kp F5  &kp F6  &kp F11
&tog WIN_MODS  &trans   &kp LC(LA(LG(LEFT)))  &kp LC(LA(DOWN))  &kp LC(LA(LG(RIGHT)))  &bt BT_SEL 2   &none  &kp F1  &kp F2  &kp F3  &kp F10  &none
                                &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

// ════════════════════════════════════════════════════════════════
// 7: WIN_MODS — completely empty (conditional layer trigger flag)
//    Do not add any bindings here. See plan for explanation.
// ════════════════════════════════════════════════════════════════
        win_mods_layer {
            bindings = <
&trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans &trans
                     &trans &trans    &trans &trans &trans &trans
            >;
        };

// ════════════════════════════════════════════════════════════════
// 8: WIN_LOWER — Windows overrides active when LOWER + WIN_MODS
//    Only defines keys that differ from Mac defaults in LOWER.
// ════════════════════════════════════════════════════════════════
        win_lower_layer {
            bindings = <
&trans  &kp LC(F4)  &trans  &kp LC(LS(T))  &trans    &trans &trans &trans &trans &trans
&trans  &trans      &trans  &trans         &trans    &trans &trans &trans &trans &trans
&trans  &trans      &trans  &trans         &trans    &trans &trans &trans &trans &trans &trans &trans
                    &trans  &trans         &trans    &trans &trans &trans
            >;
        };

// ════════════════════════════════════════════════════════════════
// 9: WIN_RAISE — Windows overrides active when RAISE + WIN_MODS
//    Only defines keys that differ from Mac defaults in RAISE.
// ════════════════════════════════════════════════════════════════
        win_raise_layer {
            bindings = <
&trans &trans    &trans    &trans    &trans    &trans &trans &trans &trans &trans
&trans &trans    &trans    &trans    &trans    &trans &trans &trans &trans &trans
&win_status  &trans  &kp LC(X)  &kp LC(C)  &kp LC(V)  &trans    &trans &trans &trans &trans &trans &trans
                     &trans     &trans     &trans     &trans    &trans &trans
            >;
        };

// ════════════════════════════════════════════════════════════════
// 10: WIN_ADJUST — Windows overrides active when ADJUST + WIN_MODS
//     Only defines keys that differ from Mac defaults in ADJUST.
//     D (maximize) stays &trans — unimplemented in QMK too.
// ════════════════════════════════════════════════════════════════
        win_adjust_layer {
            bindings = <
&trans &trans           &kp LG(UP)     &trans           &trans    &trans &trans &trans &trans &trans
&trans &kp LG(LEFT)     &trans         &kp LG(RIGHT)    &trans    &trans &trans &trans &trans &trans
&trans &kp LS(LG(LEFT)) &kp LG(DOWN)  &kp LS(LG(RIGHT)) &trans   &trans &trans &trans &trans &trans &trans &trans
                         &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
